---
import { Image } from "astro:assets";
import img from "../assets/hero-img.jpg";
---

<section
    class="relative w-full overflow-hidden bg-surface py-8 sm:py-12 lg:py-20"
>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12"
        >
            <!-- Copy -->
            <div class="flex flex-col items-start lg:col-span-7 lg:pr-6">
                <!-- Badge -->
                <div
                    class="badge badge-secondary my-2 max-w-full px-3 py-3 text-xs sm:badge-md sm:text-sm"
                >
                    <span
                        class="h-2 w-2 shrink-0 rounded-full bg-[#25D366] animate-pulse"
                    ></span>
                    <span class="truncate">
                        Maestro Oficial  •  +12 años de experiencia
                    </span>
                </div>
                <!-- Title -->
                <h1
                    class="mb-4 text-3xl font-bold leading-[1.08] tracking-tight text-primary sm:text-4xl md:text-5xl lg:mb-6 lg:text-5xl"
                >
                    Transformamos tus espacios con <span class="text-secondary">
                        acabados impecables
                    </span> y duraderos.
                </h1>
                <!-- Description -->
                <p
                    class="mb-6 max-w-xl text-base font-semibold leading-relaxed text-secondary/80 sm:text-lg lg:mb-8"
                >
                    Pintura profesional de interiores y exteriores. Acabados
                    limpios, sin manchas y con presupuesto cerrado en minutos
                    por WhatsApp.
                </p>
                <!-- CTAs -->
                <div
                    class="mb-2 flex w-full flex-col gap-3 sm:mb-10 sm:flex-row sm:items-center sm:gap-4 sm:w-auto"
                >
                    <!-- WhatsApp -->
                    <a class="btn btn-success md:btn-xl"
                        href="https://wa.me/34612345678?text=Hola%2C%20quisiera%20pedir%20presupuesto%20para%20pintar%20mi%20vivienda"
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        <span class="material-symbols-outlined text-[24px]">
                            chat
                        </span>
                        <span class="text-left leading-tight">
                            <span
                                class="block text-[11px] uppercase tracking-wider opacity-90"
                            >
                                ¿Necesitas un pintor?
                            </span>
                            <span class="block text-sm font-bold sm:text-base">
                                Comunícate por WhatsApp
                            </span>
                        </span>
                    </a>
                    <!-- Gallery -->
                    <a class="btn btn-info md:btn-xl"
                        href="/galeria"
                    >
                        <span class="material-symbols-outlined text-[20px]">
                            photo_library
                        </span>
                        <span class="text-sm font-semibold sm:text-base">
                            Ver Galería de trabajos
                        </span>
                    </a>
                </div>
            </div>
            <!-- Hero Image -->
            <div class="relative mt-2 lg:col-span-5 lg:mt-0">
                <div
                    class="relative aspect-4/3 w-full overflow-hidden rounded-2xl bg-surface-container shadow-xl sm:aspect-16/10 lg:aspect-4/5 lg:rounded-xl lg:shadow-2xl"
                >
                    <Image
                        src={img}
                        alt="Trabajo profesional de pintura y acabados"
                        class="h-full w-full object-cover"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
