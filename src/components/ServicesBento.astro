        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
                <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold block mb-2">
                    Procesos de trabajo
                </span>
                <h2
                    class="font-headline-lg text-headline-lg text-primary tracking-tight"
                >
                    Servicios con acabados de alta precisión
                </h2>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
                Atque nihil illum voluptatem aliquam aut nostrum, possimus sit porro, tenetur distinctio similique.
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">


            <!-- Service 1: Interior Painting -->

            <ServiceCard 
                img={img1} 
