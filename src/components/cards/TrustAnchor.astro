---
const { icon, desc, expl } = Astro.props
---

<div class="flex items-center gap-3 p-3 rounded-lg bg-info shadow-sm m-2 lg:py-5">
    <span class="material-symbols-outlined text-secondary-content text-[26px]">
        {icon}
    </span>
    <div>
        <h4 class="font-semibold text-md text-info-content">
            {desc}
        </h4>
        <p class="font-body-sm text-body-sm text-info-content text-xs">
            {expl}
        </p>
    </div>
</div>