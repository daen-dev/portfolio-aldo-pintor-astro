---
import Preview from '../assets/preview.jpg'
import After from '../assets/after.jpg'
import { Image } from 'astro:assets';
---

<section class="w-full py-16 md:py-24 bg-base-200" data-theme="cmyk">
    <div class="max-w-7xl mx-auto px-4 md:px-8">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

            <!-- Columna izquierda: Antes / Después -->
            <div class="lg:col-span-6 order-2 lg:order-1">

                <div class="relative w-full rounded-3xl overflow-hidden bg-base-100 p-2 sm:p-3 shadow-xl border border-base-300">

                    <div class="relative h-80 sm:h-96 md:h-[420px] rounded-2xl overflow-hidden select-none" id="before-after-box">

                        <!-- Después -->
                        <Image
                            src={After}
                            alt="Resultado con acabado liso"
                            class="absolute inset-0 w-full h-full object-cover"
                        />

                        <span
                            class="absolute top-4 right-4 z-10 badge badge-primary badge-lg shadow-lg"
                        >
                            Después · Acabado liso
                        </span>


                        <!-- Antes -->
                        <div
                            class="absolute inset-y-0 left-0 w-1/2 overflow-hidden"
                            id="before-layer"
                        >
                            <Image
                                src={Preview}
                                alt="Pared con gotelé antes del trabajo"
                                class="absolute inset-y-0 left-0 max-w-none h-full w-full object-cover"
                            />

                            <span
                                class="absolute top-4 left-4 z-10 badge badge-secondary badge-lg shadow-lg"
                            >
                                Antes · Gotelé
                            </span>
                        </div>


                        <!-- Divisor -->
                        <div
                            class="absolute inset-y-0 left-1/2 w-1 bg-base-100 shadow-2xl flex items-center justify-center"
                            id="slider-handle"
                        >
                            <div
                                class="w-11 h-11 rounded-full bg-primary text-primary-content flex items-center justify-center shadow-xl border-4 border-base-100"
                            >
                                <span class="material-symbols-outlined text-[22px]">
                                    sync_alt
                                </span>
                            </div>
                        </div>

                    </div>

                    <div class="px-3 py-4 text-center">
                        <p class="text-sm text-base-content/60">
                            Arrastra para comparar el antes y el después
                        </p>
                    </div>

                </div>

            </div>


            <!-- Columna derecha -->
            <div class="lg:col-span-6 order-1 lg:order-2">

                <div class="max-w-xl">

                    <span class="inline-flex items-center gap-2 text-sm md:text-base font-bold uppercase tracking-[0.2em] text-primary mb-3">
                        <span class="w-8 h-1 bg-primary rounded-full"></span>
                        ¿Por qué elegirnos?
                    </span>

                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-base-content leading-tight mb-5">
                        Un acabado profesional que transforma tus espacios
                    </h2>

                    <p class="text-base md:text-lg leading-relaxed text-base-content/70 mb-8">
                        Trabajamos cada superficie con cuidado y precisión para
                        conseguir paredes lisas, limpias y con un acabado
                        profesional que puedas disfrutar durante años.
                    </p>


                    <!-- Compromisos -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

                        <div class="flex items-start gap-3 p-4 rounded-2xl bg-base-100 border border-base-300 shadow-sm">
                            <div class="shrink-0 w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                                <span class="material-symbols-outlined">
                                    verified
                                </span>
                            </div>

                            <div>
                                <h3 class="font-bold text-base-content">
                                    Trabajo profesional
                                </h3>
                                <p class="text-sm text-base-content/60 mt-1">
                                    Cuidamos cada detalle del proceso.
                                </p>
                            </div>
                        </div>


                        <div class="flex items-start gap-3 p-4 rounded-2xl bg-base-100 border border-base-300 shadow-sm">
                            <div class="shrink-0 w-10 h-10 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center">
                                <span class="material-symbols-outlined">
                                    schedule
                                </span>
                            </div>

                            <div>
                                <h3 class="font-bold text-base-content">
                                    Cumplimos los plazos
                                </h3>
                                <p class="text-sm text-base-content/60 mt-1">
                                    Organizamos el trabajo para terminar a tiempo.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>

