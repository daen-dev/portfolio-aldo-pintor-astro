---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro"
import TrustAnchore from "../components/cards/TrustAnchor.astro"
import ServicesBento from "../components/ServicesBento.astro"
import WhyUs from "../components/WhyUs.astro";
import Galery from "../components/Galery.astro";
---

<Layout>
	
	<main class="w-full">
		<div class="flex flex-col w-full">

			<!-- Top Ambient Hero Canvas -->
			<Hero />


			<!-- Quick Floating WhatsApp Bar / Trust Anchors -->
			<section class="w-full py-6">
				<div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin">
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4" >

						<TrustAnchore icon="schedule", desc="Puntualidad", expl="Aún con lluvia, si el trabajo se puede hacer, se hace..." />
						<TrustAnchore icon="handyman", desc="Profesionalismo", expl="Trabajos precisos y de calidad garantizada" />
						
					</div>
				</div>
			</section>



			<!-- Highlighted Services Bento -->
			<ServicesBento />

			
			<!-- Why Choose Us / Value Proposition -->
			
			<WhyUs />

			<!-- Recent Projects Showcase / Teaser Gallery -->
			<Galery />

	



			
		</div>
	</main>
	
	
</Layout>
